# The FRESH source. Redistribution terms are not clear, so it stays out — the generator
# reproduces the derived dataset from a local copy.
apple_crops/*
!apple_crops/.gitkeep

# Everything the notebooks produce. Regenerated by running them, and large.
runs/*
!runs/.gitkeep
!runs/*/.gitkeep

# Superseded weights from earlier configurations. Shipping these invites someone to load the
# wrong one; the four the planner uses are committed.
models/station_planner.pt
models/pick_policy_total*.pt
models/*_v1.*
models/*_v2.*
models/*.bak

# Presentation material. The clips and the notebooks that make them were built for a project
# submission, not for reproducing the results, and none of the numbers depend on them.
visual/
*.mp4
*.webp

# MuJoCo writes this beside whatever called it.
MUJOCO_LOG.TXT

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# Backups left by the notebook patch script
*.bak

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Staging helper ? belongs to the working tree, not the release.
stage_repo.ps1
patch_notebooks.py
